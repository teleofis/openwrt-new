#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99

boot() {
	case $(board_name) in
	teleofis,rtu1068v5)
		[ "$(fw_printenv -n upgrade_available 2>/dev/null)" = "1" ] || return 0
		fw_setenv -s - <<-EOF
			upgrade_available
			bootcount
		EOF
		logger -t bootcount "slot $(cmdline_get_var ab_slot) confirmed"
		;;
	esac
}
